<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime with audio input (§6.3 / §11.7). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- NO App Sandbox: controlling other apps via Accessibility and posting global events is
         incompatible with the sandbox (ORA-PLAT-005). The sandbox entitlement is intentionally absent. -->
</dict>
</plist>
