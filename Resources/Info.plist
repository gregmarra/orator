<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Orator</string>
    <key>CFBundleIdentifier</key>
    <string>com.grgmrr.orator</string>
    <key>CFBundleExecutable</key>
    <string>Orator</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <!-- Build fingerprint. CFBundleVersion and the two ORA* keys below are OVERWRITTEN at assembly
         time by Scripts/bundle.sh from git (commit count, short hash + dirty flag, UTC timestamp);
         the values here are only what an unstamped hand-assembled bundle would show.
         CFBundleShortVersionString above is the opposite: hand-edited here, never stamped. -->
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>ORAGitRevision</key>
    <string>unknown</string>
    <key>ORABuildDate</key>
    <string>unknown</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>

    <!-- Menu-bar agent: no Dock icon, no default window (ORA-PLAT-004). -->
    <key>LSUIElement</key>
    <true/>

    <!-- TCC usage description (§6.4). The streaming SpeechAnalyzer path needs no speech-recognition
         prompt, so only Microphone is declared. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Orator captures your speech only while you are dictating, entirely on-device.</string>
</dict>
</plist>
